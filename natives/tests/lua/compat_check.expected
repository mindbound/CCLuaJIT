# Expected output of compat_check.lua, compared by run-harnesses.sh after removing CR and NUL bytes (the second
# key holds two NULs) and the tab-indented "no field/no file" lines under the ffi error. Lines starting with '#'
# are ignored. The values are those of every verified build in docs/port-1.21.1/artifacts/luajit-patches/results/,
# except the last three lines (exact decimal ties): they are S2's values (docs/port-1.21.1/S2.md, D34), because
# patch 05 now rounds ties half up, as Cobalt does.
NUL in bracket class               true
match('abcd','bc') len           3
tostring(0.1+0.2)                  0.30000000000000004
tostring(2^53-1)                   9007199254740991
load(string.dump(f))               nil
goto as field/function name        5
real goto statement                3
table.pack/unpack (52COMPAT)       5
ffi disabled                       ERR: module 'ffi' not found:
jit on                             true
tostring(391.786041259765625)      391.78604125976563
%.17g of 391.786041259765625       391.78604125976563
%.0f %.2f of 2.5, 0.125            3 0.13
