-/* Find fixed string p inside string s. */
+/* CC: Two-Way string matching (Crochemore & Perrin, 1991). Worst case
+** O(slen+plen) time and O(1) space. Used by lj_str_find() as a fallback.
+*/
+
+/* Critical factorization: returns the start of the right half of p and
+** stores the period of the right half.
+*/
+static MSize str_tw_factor(const uint8_t *p, MSize plen, MSize *period)
+{
+  MSize ms, msr, j, k, per, perr;
+  ms = (MSize)-1; j = 0; k = per = 1;  /* Maximal suffix for '<'. */
+  while (j + k < plen) {
+    uint8_t a = p[j + k], b = p[ms + k];
+    if (a < b) { j += k; k = 1; per = j - ms; }
+    else if (a == b) { if (k != per) k++; else { j += per; k = 1; } }
+    else { ms = j++; k = per = 1; }
+  }
+  msr = (MSize)-1; j = 0; k = perr = 1;  /* Maximal suffix for '>'. */
+  while (j + k < plen) {
+    uint8_t a = p[j + k], b = p[msr + k];
+    if (a > b) { j += k; k = 1; perr = j - msr; }
+    else if (a == b) { if (k != perr) k++; else { j += perr; k = 1; } }
+    else { msr = j++; k = perr = 1; }
+  }
+  if (msr + 1 < ms + 1) { *period = per; return ms + 1; }
+  *period = perr; return msr + 1;
+}
+
+/* Find p (plen >= 1) in s. */
+static const char *str_find_twoway(const uint8_t *s, MSize slen,
+				   const uint8_t *p, MSize plen)
+{
+  MSize period, suffix, i, j = 0;
+  if (plen > slen) return NULL;
+  suffix = str_tw_factor(p, plen, &period);
+  if (memcmp(p, p + period, suffix) == 0) {
+    /* Periodic needle: remember how much of the right half matched. */
+    MSize memory = 0;
+    while (j <= slen - plen) {
+      i = suffix > memory ? suffix : memory;
+      while (i < plen && p[i] == s[i + j]) i++;
+      if (i >= plen) {
+	i = suffix - 1;
+	while (memory < i + 1 && p[i] == s[i + j]) i--;
+	if (i + 1 < memory + 1) return (const char *)(s + j);
+	j += period;
+	memory = plen - period;
+      } else {
+	j += i - suffix + 1;
+	memory = 0;
+      }
+    }
+  } else {
+    /* Non-periodic needle: a mismatch in the left half shifts maximally. */
+    period = (suffix > plen - suffix ? suffix : plen - suffix) + 1;
+    while (j <= slen - plen) {
+      i = suffix;
+      while (i < plen && p[i] == s[i + j]) i++;
+      if (i >= plen) {
+	i = suffix - 1;
+	while (i != (MSize)-1 && p[i] == s[i + j]) i--;
+	if (i == (MSize)-1) return (const char *)(s + j);
+	j += period;
+      } else {
+	j += i - suffix + 1;
+      }
+    }
+  }
+  return NULL;
+}
+
