+/* Interrupt polling for long-running C library functions. */
+#ifdef LUAJIT_ENABLE_INTERRUPT
+LJ_FUNC void LJ_FASTCALL lj_dispatch_intrpoll(lua_State *L);
+#define lj_intr_pollg(L, g) \
+  { if (LJ_UNLIKELY((g)->intr)) { \
+      if ((g)->intrskip) (g)->intrskip--; else lj_dispatch_intrpoll(L); } }
+#define lj_intr_poll(L)		lj_intr_pollg((L), G(L))
+#else
+#define lj_intr_poll(L)		((void)0)
+#endif
