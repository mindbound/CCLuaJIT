+#ifdef LUAJIT_ENABLE_INTERRUPT
+/* Polls from C to skip after a hook call that returned normally. */
+#ifndef LJ_INTR_CSKIP
+#define LJ_INTR_CSKIP		4096
+#endif
+
+/* Protected part of lj_dispatch_intrpoll(). */
+static TValue *intrpoll_cp(lua_State *L, lua_CFunction dummy, void *ud)
+{
+  UNUSED(dummy); UNUSED(ud);
+  callhook(L, LUA_HOOKCOUNT, -1);
+  return NULL;
+}
+
+/* Service a pending interrupt request (luaJIT_interrupt()) from inside a
+** long-running C library function, e.g. pattern matching or table.sort.
+** Called via lj_intr_poll()/lj_intr_pollg() when G(L)->intr is set and
+** g->intrskip is zero.
+**
+** The installed count hook is called exactly as at a bytecode boundary
+** (event LUA_HOOKCOUNT, currentline -1, top frame = the C function), with
+** two differences:
+** - It runs inside a protected C frame (lj_vm_cpcall), so the C function
+**   below cannot be resumed after a yield: lua_isyieldable() returns 0 and
+**   lua_yield() raises "attempt to yield across C-call boundary".
+** - An error raised by the hook is re-thrown with lj_err_throw() in the
+**   context of the C function. Like any other error raised by a library
+**   function (e.g. "pattern too complex"), it unwinds the C function's
+**   frames and is caught by the nearest pcall/xpcall/lua_pcall/resume.
+**   Like errors from ordinary hooks (see lj_err_run()), it does not run
+**   xpcall message handlers.
+** A hook that cannot service a request here (e.g. a pause, which needs a
+** yield) should re-arm it with luaJIT_interrupt(L) before returning. It is
+** then presented again at the next bytecode boundary, where the count hook
+** runs because luaJIT_interrupt() sets hookcount to 1. To keep a deferred
+** request from calling the hook at every single poll, the next
+** LJ_INTR_CSKIP polls from C after a normal return of the hook are skipped
+** (a few microseconds of matching; the count hook at the next bytecode
+** boundary resets the counter). A new request from another thread is
+** therefore seen after at most LJ_INTR_CSKIP further polls.
+**
+** Safety: the caller must be C code running on behalf of the interpreter
+** (a lua_CFunction or a fast function fallback), not a C helper called by a
+** JIT-compiled trace. The hook may reallocate the Lua stack and run the GC,
+** so the caller must not hold pointers into the Lua stack across the call.
+** L->top is preserved.
+*/
+void LJ_FASTCALL lj_dispatch_intrpoll(lua_State *L)
+{
+  global_State *g = G(L);
+  if (g->intr && g->hookf && (g->hookmask & LUA_MASKCOUNT) &&
+      !hook_active(g)
+#if LJ_HASJIT
+      && !tvref(g->jit_base)  /* Never on trace. */
+#endif
+      ) {
+    ptrdiff_t top = savestack(L, L->top);
+    uint8_t oldh = hook_save(g);
+    int status;
+    g->hookcount = g->hookcstart;
+    status = lj_vm_cpcall(L, NULL, NULL, intrpoll_cp);
+    if (LJ_UNLIKELY(status)) {
+      hook_restore(g, oldh);
+      lj_err_throw(L, status);  /* Error object is at L->top-1. */
+    }
+    L->top = restorestack(L, top);
+    g->intrskip = LJ_INTR_CSKIP;
+  }
+}
+#endif
+
