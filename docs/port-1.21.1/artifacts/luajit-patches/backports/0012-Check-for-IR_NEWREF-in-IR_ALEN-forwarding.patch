From 19114da321988e25a232afcb38d928989ff98ad2 Mon Sep 17 00:00:00 2001
From: Mike Pall <mike>
Date: Tue, 20 Oct 2026 22:11:50 +0200
Subject: [PATCH 12/17] Check for IR_NEWREF in IR_ALEN forwarding.

Thanks to Sergey Kaplun. #1534

(cherry picked from commit 95f931cb1ee7ab14f249d61fb3734803429025f8)
---
 src/lj_opt_mem.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/lj_opt_mem.c b/src/lj_opt_mem.c
index c7098777..e6475465 100644
--- a/src/lj_opt_mem.c
+++ b/src/lj_opt_mem.c
@@ -398,13 +398,16 @@ TRef LJ_FASTCALL lj_opt_fwd_alen(jit_State *J)
   IRRef lim = tab;  /* Search limit. */
   IRRef ref;
 
-  /* Search for conflicting HSTORE with numeric key. */
+  /* Search for conflicting HSTORE or NEWREF with numeric key. */
   ref = J->chain[IR_HSTORE];
   while (ref > lim) {
     IRIns *store = IR(ref);
-    IRIns *href = IR(store->op1);
-    IRIns *key = IR(href->op2);
-    if (irt_isnum(key->o == IR_KSLOT ? IR(key->op1)->t : key->t)) {
+    IRIns *xref = IR(store->op1);
+    IRIns *key = IR(xref->op2);
+    IRRef htab = xref->o == IR_HREFK ? IR(xref->op1)->op1 : xref->op1;
+    if ((tab == htab || aa_table(J, tab, htab) != ALIAS_NO) &&
+	(xref->o == IR_NEWREF ||
+	 irt_isnum(key->o == IR_KSLOT ? IR(key->op1)->t : key->t))) {
       lim = ref;  /* Conflicting store found, limits search for ALEN. */
       break;
     }
