From a8f033531355daa7eae9ca3c4b455e53863ff14b Mon Sep 17 00:00:00 2001
From: Mike Pall <mike>
Date: Fri, 30 Oct 2026 19:07:02 +0100
Subject: [PATCH 17/17] Don't FOLD ldexp with non-integer exponent.

Thanks to Sergey Kaplun. #1539

(cherry picked from commit ea9eb7edb5eac4a9d175d74523db34fac0fa5180)
---
 src/lj_opt_fold.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/lj_opt_fold.c b/src/lj_opt_fold.c
index 7fc83837..c26eaf4e 100644
--- a/src/lj_opt_fold.c
+++ b/src/lj_opt_fold.c
@@ -180,7 +180,10 @@ LJFOLDF(kfold_numarith)
 {
   lua_Number a = knumleft;
   lua_Number b = knumright;
-  lua_Number y = lj_vm_foldarith(a, b, fins->o - IR_ADD);
+  lua_Number y;
+  if (fins->o == IR_LDEXP && !lj_num2int_ok(b))
+    return NEXTFOLD;
+  y = lj_vm_foldarith(a, b, fins->o - IR_ADD);
   return lj_ir_knum(J, y);
 }
 
