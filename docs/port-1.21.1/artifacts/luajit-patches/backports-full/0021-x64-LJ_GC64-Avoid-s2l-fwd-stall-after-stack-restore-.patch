From c89956439189dd454398b1a195c0b99d117ae45d Mon Sep 17 00:00:00 2001
From: Mike Pall <mike>
Date: Thu, 29 Oct 2026 12:37:48 +0100
Subject: [PATCH 21/26] x64/LJ_GC64: Avoid s2l fwd stall after stack restore,
 part 2.

Thanks to Sergey Kaplun. #1485

(cherry picked from commit b310887b7837db58901198ec47484f1fab9d92a7)
---
 src/lj_asm_x86.h | 55 +++++++++++++++++++++---------------------------
 1 file changed, 24 insertions(+), 31 deletions(-)

diff --git a/src/lj_asm_x86.h b/src/lj_asm_x86.h
index a2cf8fe9..c63ceb6a 100644
--- a/src/lj_asm_x86.h
+++ b/src/lj_asm_x86.h
@@ -1120,15 +1120,12 @@ static void asm_tvptr(ASMState *as, Reg dest, IRRef ref, MSize mode)
 	emit_rmro(as, XO_MOVto, tmp|REX_64, dest, 0);
 	emit_loadu64(as, tmp, k.u64);
       } else {
-	/* TODO: 64 bit store + 32 bit load-modify-store is suboptimal. */
-	Reg src = ra_alloc1(as, ref, rset_exclude(RSET_GPR, dest));
-	if (irt_is64(ir->t)) {
-	  emit_u32(as, irt_toitype(ir->t) << 15);
-	  emit_rmro(as, XO_ARITHi, XOg_OR, dest, 4);
-	} else {
-	  emit_movmroi(as, dest, 4, (irt_toitype(ir->t) << 15));
-	}
-	emit_movtomro(as, REX_64IR(ir, src), dest, 0);
+	RegSet allow = rset_exclude(RSET_GPR, dest);
+	Reg src = ra_alloc1(as, ref, allow);
+	Reg tmp = ra_scratch(as, rset_exclude(allow, src));
+	emit_movtomro(as, tmp|REX_64, dest, 0);
+	emit_rr(as, XO_OR, tmp|REX_64, src|REX_64);
+	emit_loadu64(as, tmp, (uint64_t)irt_toitype(ir->t) << 47);
       }
 #else
       if (!irref_isk(ref)) {
@@ -1682,11 +1679,9 @@ static void asm_ahustore(ASMState *as, IRIns *ir)
       emit_i32(as, -1);
       emit_mrm(as, XO_MOVmi, REX_64, RID_MRM);
     } else {
-      emit_u32(as, k.u32.lo);
-      emit_mrm(as, XO_MOVmi, 0, RID_MRM);
-      as->mrm.ofs += 4;
-      emit_u32(as, k.u32.hi);
-      emit_mrm(as, XO_MOVmi, 0, RID_MRM);
+      Reg tmp = ra_scratch(as, RSET_GPR);
+      emit_mrm(as, XO_MOVto, tmp|REX_64, RID_MRM);
+      emit_loadu64(as, tmp, k.u64);
     }
 #endif
   } else {
@@ -1701,12 +1696,10 @@ static void asm_ahustore(ASMState *as, IRIns *ir)
     if (ra_hasreg(src)) {
 #if LJ_GC64
       if (!(LJ_DUALNUM && irt_isinteger(ir->t))) {
-	/* TODO: 64 bit store + 32 bit load-modify-store is suboptimal. */
-	as->mrm.ofs += 4;
-	emit_u32(as, irt_toitype(ir->t) << 15);
-	emit_mrm(as, XO_ARITHi, XOg_OR, RID_MRM);
-	as->mrm.ofs -= 4;
-	emit_mrm(as, XO_MOVto, src|REX_64, RID_MRM);
+	Reg tmp = ra_scratch(as, rset_exclude(allow, src));
+	emit_mrm(as, XO_MOVto, tmp|REX_64, RID_MRM);
+	emit_rr(as, XO_OR, tmp|REX_64, src|REX_64);
+	emit_loadu64(as, tmp, (uint64_t)irt_toitype(ir->t) << 47);
 	return;
       }
 #endif
@@ -2769,19 +2762,19 @@ static void asm_stack_restore(ASMState *as, SnapShot *snap)
 		 (LJ_DUALNUM && irt_isinteger(ir->t)),
 		 "restore of IR type %d", irt_type(ir->t));
       if (!irref_isk(ref)) {
-	Reg src = ra_alloc1(as, ref, rset_exclude(RSET_GPR, RID_BASE));
+	RegSet allow = rset_exclude(RSET_GPR, RID_BASE);
+	Reg src = ra_alloc1(as, ref, allow);
 #if LJ_GC64
-	if (irt_is64(ir->t)) {
-	  /* TODO: 64 bit store + 32 bit load-modify-store is suboptimal. */
-	  emit_u32(as, irt_toitype(ir->t) << 15);
-	  emit_rmro(as, XO_ARITHi, XOg_OR, RID_BASE, ofs+4);
-	} else if (LJ_DUALNUM && irt_isinteger(ir->t)) {
-	  emit_movmroi(as, RID_BASE, ofs+4, LJ_TISNUM << 15);
-	} else {
-	  emit_movmroi(as, RID_BASE, ofs+4, (irt_toitype(ir->t)<<15)|0x7fff);
-	}
-#endif
+	Reg tmp = ra_scratch(as, rset_exclude(allow, src));
+	uint64_t tag;
+	emit_rmro(as, XO_MOVto, tmp|REX_64, RID_BASE, ofs);
+	tag = (LJ_DUALNUM && !irt_is64(ir->t) && irt_isinteger(ir->t)) ?
+	      LJ_TISNUM : irt_toitype(ir->t);
+	emit_rr(as, XO_OR, tmp|REX_64, src|REX_64);
+	emit_loadu64(as, tmp, tag << 47);
+#else
 	emit_movtomro(as, REX_64IR(ir, src), RID_BASE, ofs);
+#endif
 #if LJ_GC64
       } else {
 	TValue k;
