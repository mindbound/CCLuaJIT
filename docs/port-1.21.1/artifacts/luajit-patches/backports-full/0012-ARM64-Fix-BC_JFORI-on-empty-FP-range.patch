From 2496972e21d88e997b24f69d8331c97d281d8ff7 Mon Sep 17 00:00:00 2001
From: Mike Pall <mike>
Date: Tue, 13 Oct 2026 12:03:27 +0200
Subject: [PATCH 12/26] ARM64: Fix BC_JFORI on empty FP range.

Thanks to denesik. #1530

(cherry picked from commit 2c9f5cf62ca9232d1aa3271f8e9c1799dd0f63d3)
---
 src/vm_arm64.dasc | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/vm_arm64.dasc b/src/vm_arm64.dasc
index be8b76a7..e2c1011f 100644
--- a/src/vm_arm64.dasc
+++ b/src/vm_arm64.dasc
@@ -3875,6 +3875,7 @@ static void build_ins(BuildCtx *ctx, BCOp op, int defop)
     if (op == BC_FORI) {
       |  csel PC, RC, PC, hi
     } else if (op == BC_JFORI) {
+      |  mov PC, RC
       |  ldrh RCw, [RC, #-4+OFS_RD]
       |  bls =>BC_JLOOP
     } else if (op == BC_IFORL) {
