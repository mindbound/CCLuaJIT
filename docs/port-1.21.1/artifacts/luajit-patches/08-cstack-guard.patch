+/* C stack guard. Only available with -DLUAJIT_ENABLE_CSTACKGUARD builds.
+** Sets the red zone [lo, hi) of the C stack of the calling thread: while the
+** C stack pointer is inside it, C code that re-enters the VM (lua_call,
+** lua_pcall, lua_cpcall, lua_resume, metamethods called via the C API,
+** coroutine.resume/wrap, gsub/sort callbacks, __tostring, the parser) gets a
+** catchable "C stack overflow" error instead of overflowing the native stack.
+** lua_pcall/lua_cpcall return it as an error status, lua_resume returns
+** LUA_ERRRUN with the message on the coroutine's stack and leaves the
+** coroutine resumable. Call it from the thread that is about to run the
+** state, e.g. before every lua_resume if the host uses a thread pool.
+*/
+LUA_API void luaJIT_setcstacklimit(lua_State *L, const void *lo,
+				   const void *hi);
+
 /* Enforce (dynamic) linker error for version mismatches. Call from main. */
 LUA_API void LUAJIT_VERSION_SYM(void);
 
