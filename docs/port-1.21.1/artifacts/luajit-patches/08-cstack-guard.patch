+#ifdef LUAJIT_ENABLE_CSTACKGUARD
+/* Set the C stack red zone [lo, hi) of the thread that runs L from now on.
+** Re-entries from C into the VM raise "C stack overflow" while the C stack
+** pointer is inside the zone. Usually lo = lowest address of the thread's
+** stack reservation (plus what the OS/JVM reserve there) and hi = lo +
+** safety margin. The margin must cover the C stack used between two guard
+** points plus error handling (>= 64 KB recommended, more under a JVM).
+** If the state migrates to another thread, call this again from that thread
+** before running Lua code; a stale zone of another thread is harmless (the
+** guard is simply inactive). lo == hi disables the guard.
+*/
+LUA_API void luaJIT_setcstacklimit(lua_State *L, const void *lo, const void *hi)
+{
+  global_State *g = G(L);
+  uintptr_t l = (uintptr_t)lo, h = (uintptr_t)hi;
+  g->cstack_lo = h > l ? l : 0;
+  g->cstack_hi = h > l ? h : 0;
+}
+#endif
+
