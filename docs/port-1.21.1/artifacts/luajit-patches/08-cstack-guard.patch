+/* C stack guard (LUAJIT_ENABLE_CSTACKGUARD), see luaJIT_setcstacklimit().
+** Every point where C code re-enters the VM (lua_call, lua_pcall, lua_cpcall,
+** lua_resume, metamethod calls from the C API, coroutine.resume/wrap, parser
+** nesting) checks that the C stack pointer is not inside the red zone of the
+** current thread's stack. Recursion through C therefore ends with a
+** catchable "C stack overflow" error instead of a native stack overflow.
+*/
+#ifdef LUAJIT_ENABLE_CSTACKGUARD
+#if defined(__GNUC__) || defined(__clang__)
+#define lj_cstack_sp()		((uintptr_t)__builtin_frame_address(0))
+#elif defined(_MSC_VER)
+#include <intrin.h>
+#define lj_cstack_sp()		((uintptr_t)_AddressOfReturnAddress())
+#else
+#error "LUAJIT_ENABLE_CSTACKGUARD: no way to get the C stack pointer"
+#endif
+/* Stack pointer sp inside [lo-slack, hi)? The common case (sp >= hi) costs
+** one compare. The stack pointer of another thread is never inside, so the
+** guard is inactive (not wrong) if the state runs on another thread.
+*/
+#define lj_cstack_inzone(g, sp, slack) \
+  (LJ_UNLIKELY((uintptr_t)(sp) < (g)->cstack_hi) && \
+   (uintptr_t)(sp) + (slack) >= (g)->cstack_lo)
+#define lj_cstack_low(L)	lj_cstack_inzone(G(L), lj_cstack_sp(), 0)
+#define lj_cstack_check(L) \
+  { if (LJ_UNLIKELY(lj_cstack_low(L))) lj_err_cstkov(L); }
+#else
+#define lj_cstack_low(L)	0
+#define lj_cstack_check(L)	((void)0)
+#endif
+
 LJ_FUNC lua_State *lj_state_new(lua_State *L);
 LJ_FUNC void LJ_FASTCALL lj_state_free(global_State *g, lua_State *L);
 #if LJ_64 && !LJ_GC64 && !(defined(LUAJIT_USE_VALGRIND) && defined(LUAJIT_USE_SYSMALLOC))
